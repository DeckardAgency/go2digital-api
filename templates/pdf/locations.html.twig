<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page {
            margin: 0;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 11px;
            color: #03120F;
            line-height: 1.4;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .page {
            padding: {{ layout.margins.top }}mm {{ layout.margins.right }}mm {{ layout.margins.bottom }}mm {{ layout.margins.left }}mm;
        }

        /* ═══ HEADER ═══ */
        .header {
            display: table;
            width: 100%;
            margin-bottom: 40px;
        }

        .header-left {
            display: table-cell;
            vertical-align: top;
        }

        .header-right {
            display: table-cell;
            vertical-align: top;
            text-align: right;
            width: 150px;
        }

        .header-title {
            font-size: 52px;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1;
            color: {{ layout.header.bgColor }};
        }

        .header-count {
            font-size: 22px;
            font-weight: 400;
            vertical-align: super;
            color: {{ layout.header.bgColor }};
            opacity: 0.5;
        }

        .header-logo {
            max-height: 28px;
        }

        /* ═══ LOCATION CARDS ═══ */
        .location-card {
            display: table;
            width: 100%;
            border-top: 1px solid #E5E5E5;
            padding: 24px 0;
            page-break-inside: avoid;
        }

        .location-card:last-child {
            border-bottom: 1px solid #E5E5E5;
        }

        .col-index {
            display: table-cell;
            vertical-align: top;
            width: 60px;
            font-size: 14px;
            font-weight: 400;
            color: #03120F;
            padding-top: 2px;
        }

        .col-name {
            display: table-cell;
            vertical-align: top;
            width: 200px;
            padding-right: 20px;
        }

        .col-name-text {
            font-size: 16px;
            font-weight: 500;
            line-height: 1.3;
            color: #03120F;
        }

        .col-specs {
            display: table-cell;
            vertical-align: top;
        }

        .specs-grid {
            display: table;
            width: 100%;
        }

        .specs-row {
            display: table-row;
        }

        .spec-cell {
            display: table-cell;
            vertical-align: top;
            padding-bottom: 12px;
            padding-right: 30px;
            width: 50%;
        }

        .spec-label {
            font-size: 10px;
            color: #999;
            margin-bottom: 2px;
        }

        .spec-value {
            font-size: 12px;
            font-weight: 500;
            color: #03120F;
        }

        .col-image {
            display: table-cell;
            vertical-align: top;
            width: 160px;
            text-align: right;
        }

        .col-image img {
            width: 150px;
            height: 100px;
            object-fit: cover;
            border-radius: 6px;
        }

        .col-image-placeholder {
            width: 150px;
            height: 100px;
            background: #f0f0f0;
            border-radius: 6px;
        }

        /* ═══ FOOTER BANNER ═══ */
        .footer-banner {
            background-color: {{ layout.header.accentColor }};
            padding: 50px {{ layout.margins.left }}mm 30px;
            margin-top: 40px;
            page-break-inside: avoid;
        }

        .footer-banner-title {
            font-size: 72px;
            font-weight: 900;
            letter-spacing: -0.04em;
            line-height: 1;
            color: {{ layout.header.bgColor }};
            margin-bottom: 40px;
        }

        .footer-contacts {
            display: table;
            width: 100%;
            padding-top: 20px;
            border-top: 1px solid rgba(3, 18, 15, 0.15);
        }

        .footer-contact {
            display: table-cell;
            vertical-align: top;
            width: 33%;
        }

        .footer-contact-label {
            font-size: 11px;
            font-weight: 600;
            color: {{ layout.header.bgColor }};
            margin-bottom: 4px;
        }

        .footer-contact-value {
            font-size: 11px;
            color: {{ layout.header.bgColor }};
            opacity: 0.6;
        }
    </style>
</head>
<body>
    <div class="page">
        {# ── HEADER ── #}
        <div class="header">
            <div class="header-left">
                <span class="header-title">{{ layout.header.subtitle }}</span><span class="header-count">({{ count }})</span>
            </div>
            <div class="header-right">
                {% if layout.header.logo %}
                    <img src="{{ layout.header.logo }}" class="header-logo" alt="{{ layout.header.title }}">
                {% else %}
                    <span style="font-size: 14px; font-weight: 700; letter-spacing: 0.05em; color: #03120F;">GO <span style="color: {{ layout.header.accentColor }};">2</span> DIGITAL</span>
                {% endif %}
            </div>
        </div>

        {# ── LOCATION CARDS ── #}
        {% for location in locations %}
            <div class="location-card">
                <div class="col-index">{{ '%02d'|format(loop.index) }}</div>

                <div class="col-name">
                    <div class="col-name-text">{{ location.name }}</div>
                </div>

                <div class="col-specs">
                    <div class="specs-grid">
                        <div class="specs-row">
                            {% if location.city %}
                            <div class="spec-cell">
                                <div class="spec-label">Grad</div>
                                <div class="spec-value">{{ location.city }}</div>
                            </div>
                            {% endif %}
                            {% if location.resolution is defined and location.resolution %}
                            <div class="spec-cell">
                                <div class="spec-label">Rezolucija</div>
                                <div class="spec-value">{{ location.resolution }}</div>
                            </div>
                            {% endif %}
                        </div>
                        <div class="specs-row">
                            {% if location.duration is defined and location.duration %}
                            <div class="spec-cell">
                                <div class="spec-label">Trajanje</div>
                                <div class="spec-value">{{ location.duration }}</div>
                            </div>
                            {% endif %}
                            {% if location.type is defined and location.type %}
                            <div class="spec-cell">
                                <div class="spec-label">Tip</div>
                                <div class="spec-value">{{ location.type }}</div>
                            </div>
                            {% endif %}
                        </div>
                        <div class="specs-row">
                            {% if location.environments is defined and location.environments|length > 0 %}
                            <div class="spec-cell">
                                <div class="spec-label">Okolina</div>
                                <div class="spec-value">{{ location.environments|join(', ') }}</div>
                            </div>
                            {% endif %}
                            {% if location.reach is defined and location.reach %}
                            <div class="spec-cell">
                                <div class="spec-label">Prosječni doseg</div>
                                <div class="spec-value">{{ location.reach }}</div>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-image">
                    {% if location.image %}
                        <img src="{{ location.image }}" alt="{{ location.name }}">
                    {% else %}
                        <div class="col-image-placeholder"></div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    {# ── FOOTER BANNER ── #}
    <div class="footer-banner">
        <div class="footer-banner-title">{{ layout.header.title }} © {{ 'now'|date('Y') }}</div>

        <div class="footer-contacts">
            <div class="footer-contact">
                <div class="footer-contact-label">E-mail</div>
                <div class="footer-contact-value">sales@go2digital.com</div>
            </div>
            <div class="footer-contact">
                <div class="footer-contact-label">Phone</div>
                <div class="footer-contact-value">+385 1 483 9192</div>
            </div>
            <div class="footer-contact">
                <div class="footer-contact-label">Location</div>
                <div class="footer-contact-value">Radnička cesta 52, 10 000 Zagreb</div>
            </div>
        </div>
    </div>
</body>
</html>
